generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          UserRole  @default(PASSENGER)
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  otpCode       String?
  otpExpiresAt  DateTime?
  refreshToken  String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  driver        Driver?
  notifications Notification[]
  auditLogs     AuditLog[]
  reports       Report[]

  @@index([email])
  @@index([role])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SCHEDULER
  DEPOT_MANAGER
  DRIVER
  PASSENGER
}

// ============================================================================
// BUS & FLEET
// ============================================================================

model Bus {
  id                  String    @id @default(cuid())
  busNumber           String    @unique
  registrationNumber  String    @unique
  capacity            Int
  model               String
  manufacturer        String
  yearOfManufacture   Int?
  fuelType            FuelType  @default(DIESEL)
  mileage             Float?
  status              BusStatus @default(ACTIVE)
  currentDriverId     String?
  gpsDeviceId         String?
  photo               String?
  insuranceNumber     String?
  insuranceExpiry     DateTime?
  fitnessExpiry       DateTime?
  lastServiceDate     DateTime?
  nextServiceDate     DateTime?
  totalKmRun          Float     @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  depot               Depot?    @relation(fields: [depotId], references: [id])
  depotId             String?
  trips               Trip[]
  maintenanceRecords  MaintenanceRecord[]
  fuelRecords         FuelRecord[]
  gpsLogs             GPSLog[]

  @@index([busNumber])
  @@index([status])
  @@index([depotId])
}

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  BREAKDOWN
}

enum FuelType {
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

// ============================================================================
// DRIVER
// ============================================================================

model Driver {
  id                String      @id @default(cuid())
  employeeId        String      @unique
  licenseNumber     String      @unique
  licenseExpiry     DateTime
  emergencyContact  String?
  emergencyPhone    String?
  shift             ShiftType   @default(MORNING)
  experience        Int         @default(0) // years
  medicalFitness    Boolean     @default(true)
  medicalExpiryDate DateTime?
  performanceScore  Float       @default(5.0)
  totalTrips        Int         @default(0)
  isAvailable       Boolean     @default(true)
  documents         String[]    @default([])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String      @unique
  depot             Depot?      @relation(fields: [depotId], references: [id])
  depotId           String?
  trips             Trip[]
  attendance        Attendance[]

  @@index([employeeId])
  @@index([shift])
  @@index([depotId])
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  SPLIT
}

// ============================================================================
// ROUTE & STOPS
// ============================================================================

model Route {
  id                String      @id @default(cuid())
  routeNumber       String      @unique
  name              String
  source            String
  destination       String
  distance          Float       // km
  estimatedTime     Int         // minutes
  fare              Float
  peakFrequency     Int         @default(10) // minutes
  normalFrequency   Int         @default(20)
  nightFrequency    Int         @default(45)
  isActive          Boolean     @default(true)
  polyline          String?     // encoded polyline for map
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  stops             RouteStop[]
  trips             Trip[]
  passengerDemand   PassengerDemand[]

  @@index([routeNumber])
  @@index([isActive])
}

model BusStop {
  id                    String    @id @default(cuid())
  name                  String
  code                  String    @unique
  latitude              Float
  longitude             Float
  shelterAvailable      Boolean   @default(false)
  digitalDisplay        Boolean   @default(false)
  passengerCapacity     Int       @default(50)
  wheelchairAccessible  Boolean   @default(false)
  nearbyLandmark        String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  routeStops            RouteStop[]

  @@index([code])
  @@index([latitude, longitude])
}

model RouteStop {
  id            String    @id @default(cuid())
  sequence      Int
  distanceFromStart Float @default(0)
  timeFromStart Int       @default(0) // minutes

  // Relations
  route         Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId       String
  stop          BusStop   @relation(fields: [stopId], references: [id], onDelete: Cascade)
  stopId        String

  @@unique([routeId, stopId])
  @@unique([routeId, sequence])
  @@index([routeId])
}

// ============================================================================
// DEPOT
// ============================================================================

model Depot {
  id              String    @id @default(cuid())
  name            String
  code            String    @unique
  address         String
  latitude        Float?
  longitude       Float?
  capacity        Int       @default(100) // parking spots
  contactPhone    String?
  contactEmail    String?
  managerName     String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  buses           Bus[]
  drivers         Driver[]

  @@index([code])
}

// ============================================================================
// SCHEDULE & TRIPS
// ============================================================================

model Schedule {
  id              String    @id @default(cuid())
  name            String
  date            DateTime
  status          ScheduleStatus @default(DRAFT)
  totalTrips      Int       @default(0)
  busesUsed       Int       @default(0)
  driversUsed     Int       @default(0)
  optimizationScore Float?
  generatedBy     String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  trips           Trip[]

  @@index([date])
  @@index([status])
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Trip {
  id              String      @id @default(cuid())
  tripNumber      Int
  departureTime   DateTime
  arrivalTime     DateTime
  actualDeparture DateTime?
  actualArrival   DateTime?
  status          TripStatus  @default(SCHEDULED)
  isReturnTrip    Boolean     @default(false)
  occupancy       Int         @default(0)
  maxOccupancy    Int?
  delay           Int         @default(0) // minutes
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  schedule        Schedule?   @relation(fields: [scheduleId], references: [id])
  scheduleId      String?
  bus             Bus         @relation(fields: [busId], references: [id])
  busId           String
  driver          Driver      @relation(fields: [driverId], references: [id])
  driverId        String
  route           Route       @relation(fields: [routeId], references: [id])
  routeId         String

  @@index([scheduleId])
  @@index([status])
  @@index([departureTime])
  @@index([busId])
  @@index([driverId])
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELAYED
}

// ============================================================================
// GPS TRACKING
// ============================================================================

model GPSLog {
  id          String    @id @default(cuid())
  latitude    Float
  longitude   Float
  speed       Float     @default(0)
  heading     Float     @default(0)
  occupancy   Int       @default(0)
  timestamp   DateTime  @default(now())

  // Relations
  bus         Bus       @relation(fields: [busId], references: [id])
  busId       String

  @@index([busId])
  @@index([timestamp])
}

// ============================================================================
// MAINTENANCE
// ============================================================================

model MaintenanceRecord {
  id              String            @id @default(cuid())
  type            MaintenanceType   @default(ROUTINE)
  status          MaintenanceStatus @default(PENDING)
  description     String
  scheduledDate   DateTime
  completedDate   DateTime?
  cost            Float?
  oilChange       Boolean           @default(false)
  brakeCheck      Boolean           @default(false)
  tyreHealth      Boolean           @default(false)
  batteryCheck    Boolean           @default(false)
  engineCheck     Boolean           @default(false)
  notes           String?
  performedBy     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  bus             Bus               @relation(fields: [busId], references: [id])
  busId           String

  @@index([busId])
  @@index([status])
  @@index([scheduledDate])
}

enum MaintenanceType {
  ROUTINE
  EMERGENCY
  INSPECTION
  OVERHAUL
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ============================================================================
// FUEL
// ============================================================================

model FuelRecord {
  id              String    @id @default(cuid())
  date            DateTime
  quantity         Float     // liters
  costPerUnit     Float
  totalCost       Float
  odometer        Float
  mileage         Float?    // km/l
  fuelStation     String?
  receiptNumber   String?
  filledBy        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  bus             Bus       @relation(fields: [busId], references: [id])
  busId           String

  @@index([busId])
  @@index([date])
}

// ============================================================================
// ATTENDANCE
// ============================================================================

model Attendance {
  id              String            @id @default(cuid())
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  status          AttendanceStatus  @default(PRESENT)
  shift           ShiftType
  lateMinutes     Int               @default(0)
  overtimeMinutes Int               @default(0)
  leaveType       String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  driver          Driver            @relation(fields: [driverId], references: [id])
  driverId        String

  @@unique([driverId, date])
  @@index([driverId])
  @@index([date])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  HALF_DAY
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id          String            @id @default(cuid())
  title       String
  message     String
  type        NotificationType  @default(SYSTEM)
  isRead      Boolean           @default(false)
  data        Json?
  createdAt   DateTime          @default(now())

  // Relations
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  BUS_DELAY
  MAINTENANCE
  SHIFT_CHANGE
  EMERGENCY
  ROUTE_CHANGE
  BROADCAST
  SYSTEM
}

// ============================================================================
// PASSENGER DEMAND (for AI predictions)
// ============================================================================

model PassengerDemand {
  id              String    @id @default(cuid())
  date            DateTime
  hour            Int       // 0-23
  dayOfWeek       Int       // 0=Sunday
  passengerCount  Int
  isHoliday       Boolean   @default(false)
  isFestival      Boolean   @default(false)
  isWeekend       Boolean   @default(false)
  weatherCondition String?
  temperature     Float?
  createdAt       DateTime  @default(now())

  // Relations
  route           Route     @relation(fields: [routeId], references: [id])
  routeId         String

  @@index([routeId])
  @@index([date])
  @@index([hour])
}

// ============================================================================
// REPORTS
// ============================================================================

model Report {
  id          String    @id @default(cuid())
  title       String
  type        String    // daily, weekly, monthly
  category    String    // revenue, fuel, performance, etc.
  dateFrom    DateTime
  dateTo      DateTime
  data        Json?
  filePath    String?
  format      String?   // pdf, excel, csv
  createdAt   DateTime  @default(now())

  // Relations
  createdBy   User      @relation(fields: [userId], references: [id])
  userId      String

  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id          String    @id @default(cuid())
  action      String
  entity      String
  entityId    String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  // Relations
  user        User      @relation(fields: [userId], references: [id])
  userId      String

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ============================================================================
// SETTINGS
// ============================================================================

model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  category    String    @default("general")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([key])
  @@index([category])
}
